# Copy this file to ".env" and fill in your key.
# Get a key at https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model (default is claude-opus-5-5).
# For a cheaper/faster option you can use claude-sonnet-5-5 or claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5
